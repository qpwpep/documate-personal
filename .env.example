# Generated by `uv run python script/sync_env_example.py`.
# App defaults come from `src/infra/settings.py`.
# Benchmark override defaults are copied from `data/benchmarks/config.toml`.

# Required secrets
OPENAI_API_KEY=
TAVILY_API_KEY=

# Application settings
CHAT_MODEL="gpt-5.4-nano"
PLANNER_MODEL="gpt-5.4-nano"
SUMMARY_MODEL="gpt-5.4-nano"
PLANNER_MAX_TOKENS=1920
TAIL_HEDGE_MAX_CONCURRENCY=8
TAIL_HEDGE_MAX_ATTEMPTS=3
PLANNER_HEDGE_DELAY_SECONDS=0.5
DOCS_SEARCH_TIMEOUT_SECONDS=5
DOCS_SEARCH_HEDGE_DELAY_SECONDS=0.5
SYNTHESIS_TIMEOUT_SECONDS=20
SYNTHESIS_HEDGE_DELAY_SECONDS=0.2
SYNTHESIS_HEDGE_MAX_ATTEMPTS=4
SYNTHESIS_USE_RESPONSES_API=false
SYNTHESIS_MAX_RETRIES=0
SYNTHESIS_MAX_TOKENS=1920
SYNTHESIS_PROMPT_SNIPPET_CHARS=960
# gpt-5.4-nano: none, low, medium, high, xhigh
# gpt-5-nano: minimal, low, medium, high
SYNTHESIS_REASONING_EFFORT=
VERBOSE=true
FASTAPI_URL="http://127.0.0.1:8000"
SESSION_TTL_SECONDS=1800
MAX_ACTIVE_SESSIONS=200
SESSION_CLEANUP_INTERVAL_SECONDS=60
GENERATED_FILE_TTL_SECONDS=86400
FILE_CLEANUP_INTERVAL_SECONDS=60

# Slack
SLACK_BOT_TOKEN=
SLACK_DEFAULT_DM_EMAIL=
SLACK_DEFAULT_USER_ID=

# Benchmark / Eval overrides
JUDGE_MODEL="gpt-5.4-mini"
BENCHMARK_ENDPOINT="http://127.0.0.1:8000"
BENCHMARK_JUDGE_ENABLED=true
BENCHMARK_SLACK_ENABLED=false
BENCHMARK_SLACK_CHANNEL_ID=
BENCHMARK_SLACK_USER_ID=
BENCHMARK_SLACK_EMAIL=
