# Generated by `uv run python script/sync_env_example.py`.
# App defaults come from `src/infra/settings.py`.
# Benchmark override defaults are copied from `data/benchmarks/config.toml`.

# Required secrets
OPENAI_API_KEY=
TAVILY_API_KEY=

# Model selection
CHAT_MODEL="gpt-5.6-luna"
PLANNER_MODEL="gpt-5.6-luna"
SUMMARY_MODEL="gpt-5.6-luna"

# Planning and summary generation
SUMMARY_MAX_TOKENS=1024
PLANNER_MAX_TOKENS=1920

# Answer generation
SYNTHESIS_TIMEOUT_SECONDS=20
SYNTHESIS_USE_RESPONSES_API=false
SYNTHESIS_MAX_RETRIES=0
SYNTHESIS_MAX_TOKENS=4096
SYNTHESIS_COMPACT_MAX_TOKENS=960
SYNTHESIS_PROMPT_SNIPPET_CHARS=1800
SYNTHESIS_COMPACT_PROMPT_SNIPPET_CHARS=900
# gpt-5.6-luna: none, low, medium, high, xhigh, max
# gpt-5-nano: minimal, low, medium, high
SYNTHESIS_REASONING_EFFORT=

# Document search
DOCS_SEARCH_TIMEOUT_SECONDS=5

# Server and logging
VERBOSE=true
FASTAPI_URL="http://127.0.0.1:8000"

# Session lifecycle
SESSION_TTL_SECONDS=1800
MAX_ACTIVE_SESSIONS=200
SESSION_CLEANUP_INTERVAL_SECONDS=60

# File retention and cleanup
GENERATED_FILE_TTL_SECONDS=86400
FILE_CLEANUP_INTERVAL_SECONDS=60

# Conversation memory
MEMORY_HIGH_WATER_TURNS=8
MEMORY_LOW_WATER_TURNS=6
MEMORY_HIGH_WATER_TOKENS=32000
MEMORY_LOW_WATER_TOKENS=16000
MEMORY_HIGH_WATER_BYTES=98304
MEMORY_LOW_WATER_BYTES=49152
MEMORY_HIGH_WATER_MESSAGES=18
MEMORY_LOW_WATER_MESSAGES=14
MEMORY_SUMMARY_MAX_TOKENS=256
MEMORY_SUMMARY_MAX_BYTES=4096
MEMORY_HARD_MAX_BYTES=131072

# Slack delivery
SLACK_BOT_TOKEN=
SLACK_DEFAULT_DM_EMAIL=
SLACK_DEFAULT_USER_ID=

# Benchmark / Eval overrides
JUDGE_MODEL="gpt-5.6-luna"
BENCHMARK_ENDPOINT="http://127.0.0.1:8000"
BENCHMARK_JUDGE_ENABLED=true

# Benchmark Slack delivery
BENCHMARK_SLACK_ENABLED=false
BENCHMARK_SLACK_CHANNEL_ID=
BENCHMARK_SLACK_USER_ID=
BENCHMARK_SLACK_EMAIL=
